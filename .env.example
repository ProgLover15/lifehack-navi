# Gemini API（サーバー側のみ）
GEMINI_API_KEY="your-gemini-api-key"

# Proパスコード（カンマ区切り。購入者に配布）
PRO_CODES="demo-pro-code,another-code"

# Stripe Payment Link（フロント用・VITE_ プレフィックス必須）
VITE_STRIPE_PAYMENT_LINK_URL="https://buy.stripe.com/your-link"

# 特商法表示（公開前に設定）
VITE_OPERATOR_NAME="Your Name or Business"
VITE_OPERATOR_EMAIL="contact@example.com"
VITE_REFUND_POLICY="デジタルコンテンツの性質上、原則返金不可。不具合時は個別対応"

# 任意
PORT=3000
